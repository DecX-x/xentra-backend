generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConnectedAccountProvider {
  GOOGLE
  SLACK
  GITHUB
  CUSTOM
}

enum ConnectedAccountStatus {
  CONNECTED
  PENDING
  REVOKED
}

enum LinkCodeStatus {
  PENDING
  CLAIMED
  EXPIRED
}

enum BindingStatus {
  ACTIVE
  REVOKED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActionRequestStatus {
  PENDING
  APPROVAL_REQUIRED
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum AuditEventType {
  LINK_CODE_CREATED
  LINK_CODE_REDEEMED
  LINK_CODE_EXPIRED
  BINDING_CREATED
  PROVIDER_CONNECTED
  PROVIDER_REVOKED
  ACTION_REQUESTED
  APPROVAL_REQUESTED
  APPROVAL_GRANTED
  APPROVAL_REJECTED
  ACTION_EXECUTED
  ACTION_FAILED
}

model User {
  id                String            @id @default(uuid()) @db.Uuid
  auth0UserId       String            @unique
  email             String?           @unique
  name              String?
  connectedAccounts ConnectedAccount[]
  linkCodeClaims    LinkCode[]        @relation("LinkCodeClaimedByUser")
  runtimeBindings   RuntimeBinding[]
  actionRequests    ActionRequest[]
  approvalsResolved Approval[]        @relation("ApprovalResolvedByUser")
  auditLogs         AuditLog[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model ConnectedAccount {
  id                 String                   @id @default(uuid()) @db.Uuid
  userId             String                   @db.Uuid
  provider           ConnectedAccountProvider
  providerAccountRef String?
  status             ConnectedAccountStatus   @default(PENDING)
  scopes             String[]                 @default([])
  metadata           Json?
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@unique([userId, provider])
  @@index([userId, status])
}

model LinkCode {
  id              String         @id @default(uuid()) @db.Uuid
  code            String         @unique
  runtimeName     String
  agentId         String
  sessionKey      String
  channelName     String
  channelUserRef  String
  status          LinkCodeStatus @default(PENDING)
  expiresAt       DateTime
  claimedAt       DateTime?
  claimedByUserId String?        @db.Uuid
  bindingId       String?        @db.Uuid
  metadata        Json?
  claimedByUser   User?          @relation("LinkCodeClaimedByUser", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  binding         RuntimeBinding? @relation("LinkCodeBinding", fields: [bindingId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, expiresAt])
  @@index([runtimeName, agentId, sessionKey])
}

model RuntimeBinding {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @db.Uuid
  runtimeName    String
  agentId        String
  sessionKey     String
  channelName    String
  channelUserRef String
  status         BindingStatus   @default(ACTIVE)
  linkedAt       DateTime        @default(now())
  lastSeenAt     DateTime?
  metadata       Json?
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkCodes      LinkCode[]      @relation("LinkCodeBinding")
  actionRequests ActionRequest[]
  auditLogs      AuditLog[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([runtimeName, agentId, sessionKey, channelName, channelUserRef], map: "runtime_binding_identity_unique")
  @@index([userId, status])
  @@index([runtimeName, agentId, sessionKey])
}

model ActionRequest {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @db.Uuid
  bindingId     String              @db.Uuid
  actionName    String
  actionPayload Json
  riskLevel     RiskLevel
  status        ActionRequestStatus @default(PENDING)
  resultSummary String?
  errorMessage  String?
  executedAt    DateTime?
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  binding       RuntimeBinding      @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  approval      Approval?
  auditLogs     AuditLog[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([userId, status])
  @@index([bindingId, createdAt])
}

model Approval {
  id               String         @id @default(uuid()) @db.Uuid
  actionRequestId  String         @unique @db.Uuid
  status           ApprovalStatus @default(PENDING)
  approvedByUserId String?        @db.Uuid
  approvedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  actionRequest    ActionRequest  @relation(fields: [actionRequestId], references: [id], onDelete: Cascade)
  approvedByUser   User?          @relation("ApprovalResolvedByUser", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status, createdAt])
}

model AuditLog {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String?        @db.Uuid
  bindingId       String?        @db.Uuid
  actionRequestId String?        @db.Uuid
  eventType       AuditEventType
  eventPayload    Json?
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  binding         RuntimeBinding? @relation(fields: [bindingId], references: [id], onDelete: SetNull)
  actionRequest   ActionRequest? @relation(fields: [actionRequestId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}
